# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# WHO ICD API — OAuth2 credentials (register at https://icd.who.int/icdapi)
ICD_CLIENT_ID=your_client_id_here
ICD_CLIENT_SECRET=your_client_secret_here
ICD_API_PRIMARY=https://id.who.int
ICD_API_FALLBACK=https://icdapihome2-eme0b9bdf4fafkbg.northeurope-01.azurewebsites.net/icdapi

# LM Studio local inference server (OpenAI-compatible)
# Set USE_LOCAL_LLM=true to route all agents through LM Studio.
# Set USE_LOCAL_LLM=false (or omit) to use CLINICAL_MODEL via Gemini.
USE_LOCAL_LLM=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b

# Cloud LLM fallback (used when USE_LOCAL_LLM=false)
# CLINICAL_MODEL=gemini/gemini-2.5-flash
# GROUNDING_MODEL=gemini-2.5-flash

# Optional: Path to raw clinical data (defaults to local data folder if not specified)
# CLINICAL_DATA_PATH=./data/mimic-iv-clinical-database-demo-2.2/hosp/diagnoses_icd.csv.gz
